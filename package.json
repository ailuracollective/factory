{
  "name": "ailura-factory",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dashboard:dev": "pnpm --filter dashboard dev",
    "dashboard:build": "pnpm --filter dashboard build",
    "cli:build": "pnpm --filter cli build",
    "gateway:build": "pnpm --filter gateway build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "clippy": "pnpm -r clippy",
    "prepare": "husky",
    "lint": "pnpm format && pnpm clippy",
    "lint:check": "pnpm format:check && pnpm clippy",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
