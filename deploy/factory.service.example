[Unit]
Description=AI Factory issue listener (webhook)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/ailuracollective/factory
Environment=ISSUE_FACTORY_PROJECTS_BASE=%h/projects/ailuracollective
Environment=ISSUE_FACTORY_LABEL=status/ready
Environment=ISSUE_FACTORY_WEBHOOK_SECRET=YOUR_SECRET_HERE
Environment=ISSUE_FACTORY_WEBHOOK_PORT=8787
Environment=ISSUE_FACTORY_PROVIDER=opencode
Environment=ISSUE_FACTORY_MODEL=opencode-go/beam-free
Environment=ISSUE_FACTORY_T3=%h/.local/bin/t3
Environment=ISSUE_FACTORY_GH=%h/.local/bin/gh
Environment=PATH=/opt/az/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/ailuracollective/factory/.venv/bin/python -m factory.listener --port 8787
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
