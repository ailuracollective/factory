{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailuracollective.github.io/factory/factory.schema.json",
  "title": "Factory repo config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "profiles": {
      "type": "object",
      "description": "Named execution profiles. Each profile selects a harness and model for agent execution.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["harness", "model"],
        "properties": {
          "harness": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 }
        }
      }
    },
    "default_profile": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the profile to use when no profile is explicitly selected."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_branch": { "type": "string" },
        "label": { "type": "string" },
        "max_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "mentions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "usernames": { "type": "array", "items": { "type": "string" } },
        "usernames_extra": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "string" },
        "allowed_authors": { "type": "array", "items": { "type": "string" } },
        "daily_quota": { "type": "integer", "minimum": 0 },
        "report": { "type": "boolean" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string",
          "description": "Namespace prefix for the eight Factory execution label states. Defaults to \"ai/\". Must be a single lowercase ASCII namespace followed by '/'.",
          "default": "ai/",
          "pattern": "^[a-z0-9_-]+/$"
        }
      }
    }
  }
}
